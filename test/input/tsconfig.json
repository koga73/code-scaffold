{
	"compilerOptions": {
		"jsx": "react-jsx",
		"target": "esnext",
		"module": "esnext",
		"esModuleInterop": true,
		"allowJs": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"noImplicitAny": false,
		/* Linting */
		"strict": true,
		/* Path mapping */
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vite/client"]
	},
	"include": ["src"],
	"exclude": ["build"]
}
